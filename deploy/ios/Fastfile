default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false,
    )

    import_signing_assets

    update_project_team(
      path: "Runner.xcodeproj",
      teamid: ENV["APPLE_TEAM_ID"],
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["IOS_PROVISIONING_PROFILE_NAME"],
      bundle_identifier: "kr.sharework.sharework-mockup",
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ENV["IPA_PATH"] || "../build/ios/ipa/sharework_mockup.ipa",
      skip_waiting_for_build_processing: true,
      changelog: "Automated TestFlight build via GitHub Actions.",
    )
  end

  desc "Build and submit to App Store Connect for review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false,
    )

    import_signing_assets

    upload_to_app_store(
      api_key: api_key,
      ipa: ENV["IPA_PATH"] || "../build/ios/ipa/sharework_mockup.ipa",
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      force: true,
    )
  end

  desc "Import P12 cert + provisioning profile from base64 secrets into the runner keychain"
  private_lane :import_signing_assets do
    keychain_name = "fastlane_tmp.keychain"
    keychain_password = SecureRandom.base64

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
    )

    cert_path = "/tmp/dist_cert.p12"
    File.write(cert_path, Base64.decode64(ENV.fetch("IOS_DIST_CERT_P12_BASE64")))
    import_certificate(
      certificate_path: cert_path,
      certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
      keychain_name: keychain_name,
      keychain_password: keychain_password,
    )

    profile_path = "/tmp/profile.mobileprovision"
    File.write(profile_path, Base64.decode64(ENV.fetch("IOS_PROVISIONING_PROFILE_BASE64")))
    install_provisioning_profile(path: profile_path)
  end
end
